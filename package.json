{
  "name": "volfread.xyz",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.11.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter main dev",
    "dev:main": "pnpm --filter main dev",
    "dev:eclipse": "pnpm --filter eclipsescope dev",
    "build": "pnpm build:stats && pnpm build:main && pnpm build:web && pnpm build:csp && node scripts/copy-dist.mjs",
    "build:main": "node scripts/generate-blog-map.mjs && pnpm --filter main build",
    "build:web": "pnpm --filter eclipsescope build && pnpm --filter simulador-blockchain build",
    "build:csp": "node scripts/generate-csp.mjs",
    "build:stats": "node scripts/collect-project-stats.mjs && prettier --write packages/main/src/data/projects.stats.json",
    "build:stats:force": "node scripts/collect-project-stats.mjs --force && prettier --write packages/main/src/data/projects.stats.json",
    "preview": "pnpm --filter main preview",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,ts,astro,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,astro,json,md}\"",
    "check": "pnpm --filter main astro check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "audit": "pnpm audit --audit-level moderate",
    "update": "pnpm update && pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "opentype.js": "^2.0.0",
    "prettier-plugin-astro": "^1.1.0"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.146.0"
  }
}
