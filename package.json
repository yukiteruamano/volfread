{
  "name": "volfread.xyz",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.11.0",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter main dev",
    "dev:main": "pnpm --filter main dev",
    "build": "pnpm build:main && pnpm build:csp && node scripts/copy-dist.mjs",
    "build:main": "node scripts/generate-blog-map.mjs && pnpm --filter main build",
    "build:csp": "node scripts/generate-csp.mjs",
    "build:stats": "node scripts/collect-project-stats.mjs",
    "preview": "pnpm --filter main preview",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{js,ts,astro,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,astro,json,md}\"",
    "check": "pnpm --filter main astro check",
    "audit": "pnpm audit --audit-level moderate",
    "update": "pnpm update && pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "opentype.js": "^2.0.0"
  }
}
