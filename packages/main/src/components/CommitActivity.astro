---
interface Props {
  commits: number[]
  small?: boolean
  label?: string
  id?: string
}
const { commits, small = false, label, id } = Astro.props
const max = Math.max(...commits, 1)
const w = small ? 140 : 260
const h = small ? 28 : 40
const barW = w / commits.length
const gap = 1
const title = label ?? (small ? '52w' : 'Última actividad registrada')
const total = commits.reduce((a, b) => a + b, 0)
const gradId = id ? `volf-bar-grad-${id}` : small ? 'volf-bar-grad-sm' : 'volf-bar-grad'
---

<div class:list={['flex flex-col', small ? 'gap-1' : 'gap-2']}>
  <div class="flex items-center justify-between">
    <span class="text-[11px] tracking-widest text-volf-muted-2 uppercase">{title}</span>
    <span class="text-[11px] font-mono text-volf-muted">{total} commits · 52 sem</span>
  </div>
  <svg
    width={w}
    height={h}
    viewBox={`0 0 ${w} ${h}`}
    class="w-full rounded bg-volf-bg border border-volf-border overflow-hidden"
    role="img"
    aria-label={title + ' — ' + total + ' commits'}
  >
    <defs>
      <linearGradient id={gradId} x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="#ff6b00"></stop>
        <stop offset="100%" stop-color="#ffb84d"></stop>
      </linearGradient>
    </defs>
    {commits.map((c, i) => {
      const bh = c === 0 ? 2 : Math.max(3, (c / max) * (h - 6))
      const x = i * barW + gap / 2
      const y = h - bh - 2
      const bw = barW - gap
      const opacity = c === 0 ? 0.15 : 0.45 + 0.55 * (c / max)
      const delay = (i / commits.length) * 0.4
      return (
        <g>
          <title>
              Semana {i + 1}: {c} commits
            </title>
          <rect
            x={x}
            y={y}
            width={bw}
            height={bh}
            rx="1.5"
            fill={`url(#${gradId})`}
            opacity={opacity}
            class="motion-safe:transition-all motion-safe:duration-500 hover:opacity-100"
            style={`animation: grow 0.6s ease-out ${delay}s both`}
          />
        </g>
      )
    })}
  </svg>
</div>
