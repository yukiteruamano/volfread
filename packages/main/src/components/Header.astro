---
import { useTranslations } from '../i18n/utils'
import type { Locale } from '../i18n/ui'
import LanguageSwitcher from './LanguageSwitcher.astro'
import SearchBox from './SearchBox.astro'

interface Props {
  lang?: string
}
const lang = (Astro.props.lang ?? 'es') as Locale
const t = useTranslations(lang)

const nav = [
  { href: lang === 'en' ? '/en' : '/', label: t('nav.home') },
  { href: lang === 'en' ? '/en/projects' : '/proyectos', label: t('nav.projects') },
  { href: lang === 'en' ? '/en/blog' : '/blog', label: t('nav.blog') },
  { href: lang === 'en' ? '/en/about' : '/about', label: t('nav.about') },
]
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
function isActive(href: string): boolean {
  const normHref = href.replace(/\/$/, '') || '/'
  if (normHref === '/' || normHref === '/en') return path === normHref
  return path === normHref || path.startsWith(normHref + '/')
}
const isBlog = path.startsWith('/blog') || path.startsWith('/en/blog')
---

<header class="sticky top-0 z-50 border-b border-volf-glass-border bg-volf-glass backdrop-blur-xl shadow-glass supports-[backdrop-filter]:bg-volf-bg/60">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3.5">
    <a
      href={lang === 'en' ? '/en' : '/'}
      class="flex items-center gap-2 font-bold tracking-tight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-volf-orange focus-visible:ring-offset-2 focus-visible:ring-offset-volf-bg rounded-full"
      aria-label="volfread.xyz — inicio"
    >
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-volf-orange to-volf-amber text-xs font-black text-white shadow-glow">V</span>
      <span class="text-[15px] font-display">volfread<span class="text-volf-orange">.xyz</span></span>
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3.5 py-2 text-sm font-medium transition inline-flex items-center min-h-9 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-volf-orange focus-visible:ring-offset-2 focus-visible:ring-offset-volf-bg',
              isActive(item.href)
                ? 'bg-volf-surface text-volf-text border border-volf-border shadow-sm'
                : 'text-volf-muted hover:text-volf-text hover:bg-volf-surface/80',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      {isBlog && <SearchBox lang={lang} />}
      <LanguageSwitcher lang={lang} />
      {/* Mobile nav — accessible sheet */}
      <div class="relative md:hidden" id="mobile-nav-root">
        <button
          type="button"
          id="mobile-menu-btn"
          aria-label={lang === 'en' ? 'Open menu' : 'Abrir menú'}
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-volf-border bg-volf-surface text-volf-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-volf-orange"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="menu-icon">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="close-icon hidden">
            <path d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          <span class="sr-only">{lang === 'en' ? 'Menu' : 'Menú'}</span>
        </button>
        <div
          id="mobile-menu"
          hidden
          class="absolute right-0 mt-3 w-[min(20rem,calc(100vw-2rem))] rounded-2xl border border-volf-glass-border bg-volf-surface/95 backdrop-blur-xl shadow-glass p-2"
          role="dialog"
          aria-modal="true"
          aria-label={lang === 'en' ? 'Navigation' : 'Navegación'}
        >
          <nav aria-label={lang === 'en' ? 'Primary mobile' : 'Principal móvil'} class="flex flex-col gap-1">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="flex items-center min-h-11 rounded-xl px-4 py-2.5 text-sm font-medium text-volf-muted hover:bg-volf-surface-2 hover:text-volf-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-volf-orange"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>


