---
import CommitActivity from './CommitActivity.astro'
import statsJson from '../data/projects.stats.json'
import type { ProjectsStatsFile } from '../types'

interface Props {
  slug: string
  title: string
  description: string
  descriptionEn?: string
  type: 'web' | 'lib' | 'cli'
  lang: string
  stack: string[]
  repo: string
  featured?: boolean
  locale?: string
}
const {
  slug,
  title,
  description,
  descriptionEn,
  type,
  lang: progLang,
  stack,
  repo,
  featured,
  locale = 'es',
} = Astro.props
const stats = statsJson as unknown as ProjectsStatsFile
const s = stats.projects?.[slug]
const desc = descriptionEn && locale === 'en' ? descriptionEn : description
const href = locale === 'en' ? `/en/projects/${slug}` : `/proyectos/${slug}`
const typeLabel = type === 'web' ? 'Web' : type === 'lib' ? 'Lib' : 'CLI'
const typeColor =
  type === 'web'
    ? 'bg-gradient-to-br from-volf-orange to-volf-amber text-white border-transparent'
    : type === 'lib'
      ? 'bg-volf-surface border-volf-border text-volf-muted'
      : 'bg-volf-surface border-volf-border text-volf-amber'
const extra = Math.max(0, stack.length - 4)
---

<a
  href={href}
  class:list={[
    'group relative flex h-full flex-col overflow-hidden rounded-2xl border bg-volf-surface/80 backdrop-blur p-5 transition-all duration-200 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/20 hover:border-volf-orange/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-volf-orange focus-visible:ring-offset-2 focus-visible:ring-offset-volf-bg active:scale-[0.98]',
    featured ? 'border-volf-border hover:border-volf-orange/40' : 'border-volf-border',
  ]}
>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-volf-orange to-volf-amber opacity-0 group-hover:opacity-100 transition"></div>
  <div class="flex items-start justify-between gap-3">
    <span
      class:list={[
        'inline-flex rounded-full border px-2.5 py-1 text-[11px] font-bold tracking-widest shadow-sm',
        typeColor,
      ]}
    >
      {typeLabel}
    </span>
    <span class="rounded-full bg-volf-bg border border-volf-border px-2.5 py-1 text-xs text-volf-muted">
      {progLang}
    </span>
  </div>
  <h3 class="mt-3 text-[17px] font-semibold leading-tight text-volf-text group-hover:text-volf-orange transition">
    {title}
  </h3>
  <p class="mt-2 min-h-[2.75rem] line-clamp-2 text-sm leading-relaxed text-volf-muted">{desc}</p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {stack.slice(0, 4).map((tag: string) => (
      <span class="rounded-full bg-volf-bg/60 border border-volf-border px-2 py-1 text-[11px] text-volf-muted">
        {tag}
      </span>
    ))}
    {extra > 0 && (
      <span class="rounded-full bg-volf-orange/10 border border-volf-orange/20 px-2 py-1 text-[11px] font-medium text-volf-orange">
        +{extra}
      </span>
    )}
  </div>
  <div class="mt-4 border-t border-volf-border/60 pt-3">
    <CommitActivity commits={s?.commits52 ?? Array(52).fill(0)} small id={slug} />
  </div>
  <div class="mt-3 flex items-center justify-between text-xs">
    <span class="inline-flex items-center gap-1 font-medium text-volf-orange group-hover:gap-1.5 transition-all">
      {locale === 'en' ? 'View' : 'Ver'} <span aria-hidden="true">→</span>
    </span>
    <span class="text-volf-muted-2 truncate ml-2">{repo.replace('https://github.com/', '')}</span>
  </div>
</a>
