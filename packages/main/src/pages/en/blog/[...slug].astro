---
import { getCollection, render } from 'astro:content'
import BlogLayout from '../../../layouts/BlogLayout.astro'
import { getAlternateUrls, blogEntrySlug } from '../../../i18n/utils'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !import.meta.env.PROD || !data.draft)
  const enPosts = posts.filter((p) => p.data.lang === 'en')
  return enPosts.map((post) => ({
    params: { slug: blogEntrySlug(post.id) },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const readingTime = Math.max(1, Math.round((post.body?.split(/\s+/).length ?? 0) / 200))
let alternates = getAlternateUrls(Astro.url.pathname)
if (post.data.translationKey) {
  const allPosts = await getCollection('blog', ({ data }) => !import.meta.env.PROD || !data.draft)
  const counterpart = allPosts.find(
    (p) => blogEntrySlug(p.id) === post.data.translationKey && p.data.lang !== post.data.lang
  )
  if (counterpart) {
    const esPath = `/blog/${blogEntrySlug(counterpart.id)}`
    const enPath = `/en/blog/${blogEntrySlug(post.id)}`
    alternates = { es: esPath, en: enPath }
  }
}
const canonical = new URL(Astro.url.pathname, Astro.site).toString()
const hasMermaid = post.body?.includes('```mermaid') ?? false
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate!}
  updatedDate={post.data.updatedDate}
  lang="en"
  tags={post.data.tags}
  categories={post.data.categories}
  canonical={canonical}
  alternates={alternates}
  cover={post.data.cover}
  coverAlt={post.data.coverAlt}
  author={post.data.author}
  readingTime={readingTime}
  math={post.data.math}
  hasMermaid={hasMermaid}
>
  <Content />
</BlogLayout>
